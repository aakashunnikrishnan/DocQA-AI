# ============================================================================
# DocQA AI - Environment Configuration
# ============================================================================
# Copy this file to .env and update values as needed
# ============================================================================

# ============================================================================
# APPLICATION CONFIGURATION
# ============================================================================
# Environment: development, staging, production
ENVIRONMENT=development

# Debug mode (true/false)
DEBUG=true

# Application secret key (generate with: openssl rand -hex 32)
SECRET_KEY=your_secret_key_here_change_in_production

# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ============================================================================
# LLM PROVIDER CONFIGURATION
# ============================================================================
# Provider: openai, anthropic, azure, local
LLM_PROVIDER=openai

# Model names:
#   OpenAI: gpt-4, gpt-4-turbo-preview, gpt-4o, gpt-4o-mini, gpt-3.5-turbo
#   Anthropic: claude-3-opus-20240229, claude-3-sonnet-20240229, claude-3-haiku-20240307
#   Azure: your-deployment-name
#   Local: llama2, mistral, etc.
LLM_MODEL=gpt-4

# Temperature (0.0 to 2.0) - Higher = more creative
LLM_TEMPERATURE=0.7

# Max tokens for responses
LLM_MAX_TOKENS=2000

# Top P (0.0 to 1.0) - Nucleus sampling
LLM_TOP_P=1.0

# Frequency penalty (-2.0 to 2.0)
LLM_FREQUENCY_PENALTY=0.0

# Presence penalty (-2.0 to 2.0)
LLM_PRESENCE_PENALTY=0.0

# Request timeout in seconds
LLM_TIMEOUT=60

# Max retries for failed requests
LLM_MAX_RETRIES=3

# ============================================================================
# OPENAI API (for OpenAI provider)
# ============================================================================
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Custom OpenAI API base URL (e.g., for Azure OpenAI)
OPENAI_API_BASE=

# Optional: OpenAI organization ID
OPENAI_ORGANIZATION=

# ============================================================================
# ANTHROPIC API (for Anthropic provider)
# ============================================================================
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# ============================================================================
# AZURE OPENAI (for Azure provider)
# ============================================================================
# Azure OpenAI endpoint
AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/

# Azure OpenAI API key
AZURE_OPENAI_API_KEY=your_azure_api_key_here

# Azure OpenAI deployment name
AZURE_OPENAI_DEPLOYMENT=your-deployment-name

# Azure OpenAI API version
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# ============================================================================
# LOCAL LLM (for local provider)
# ============================================================================
# URL for local LLM endpoint (e.g., Ollama, vLLM, LocalAI)
LOCAL_LLM_URL=http://localhost:8000/v1

# Path to local model files (if using local inference)
LOCAL_MODEL_PATH=./models/llama-2-7b-chat

# Device: cuda, cpu, mps
LOCAL_MODEL_DEVICE=cuda

# Enable quantization (true/false)
LOCAL_MODEL_QUANTIZE=false

# ============================================================================
# EMBEDDING CONFIGURATION
# ============================================================================
# Provider: openai, sentence-transformers, local
EMBEDDING_PROVIDER=openai

# Model names:
#   OpenAI: text-embedding-3-small, text-embedding-3-large, text-embedding-ada-002
#   Sentence-Transformers: all-MiniLM-L6-v2, all-mpnet-base-v2, etc.
EMBEDDING_MODEL=text-embedding-3-small

# Embedding dimension (must match model):
#   text-embedding-3-small: 1536 (can reduce to 512, 1024)
#   text-embedding-3-large: 3072 (can reduce to 512, 1024, 2048)
#   text-embedding-ada-002: 1536
#   all-MiniLM-L6-v2: 384
#   all-mpnet-base-v2: 768
EMBEDDING_DIMENSION=1536

# Batch size for embedding generation
EMBEDDING_BATCH_SIZE=20

# Enable embedding cache (true/false)
EMBEDDING_CACHE_ENABLED=true

# Cache directory
EMBEDDING_CACHE_DIR=./data/embeddings/cache

# ============================================================================
# VECTOR STORE CONFIGURATION
# ============================================================================
# Store type: faiss, chromadb, qdrant, pinecone
VECTOR_STORE_TYPE=faiss

# Index type: FlatIP, FlatL2, HNSW32, HNSW64, IVF
VECTOR_INDEX_TYPE=HNSW64

# Similarity metric: cosine, l2, ip
VECTOR_METRIC=cosine

# Path to store vector index
VECTOR_STORE_PATH=./data/vector_store

# HNSW parameters
VECTOR_EF_SEARCH=100
VECTOR_EF_CONSTRUCTION=200
VECTOR_M=16

# IVF parameters
VECTOR_NLIST=100
VECTOR_NPROBE=10

# ============================================================================
# RETRIEVAL CONFIGURATION
# ============================================================================
# Number of documents to retrieve
RETRIEVAL_TOP_K=5

# Minimum similarity score threshold (0.0 to 1.0)
RETRIEVAL_SCORE_THRESHOLD=0.7

# Enable hybrid search (vector + keyword)
RETRIEVAL_HYBRID_SEARCH=true

# Enable reranking
RETRIEVAL_RERANKING=false

# Reranker model (e.g., cross-encoder/ms-marco-MiniLM-L-6-v2)
RETRIEVAL_RERANKER_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# Weight for vector similarity (0.0 to 1.0)
RETRIEVAL_VECTOR_WEIGHT=0.7

# Weight for keyword search (0.0 to 1.0)
RETRIEVAL_KEYWORD_WEIGHT=0.3

# Enable MMR diversity reranking
RETRIEVAL_MMR_ENABLED=false

# MMR diversity parameter (0.0 to 1.0)
RETRIEVAL_MMR_DIVERSITY=0.5

# Enable query expansion
RETRIEVAL_QUERY_EXPANSION=false

# Number of expansion terms
RETRIEVAL_EXPANSION_TERMS=3

# ============================================================================
# API CONFIGURATION
# ============================================================================
# Host to bind to (0.0.0.0 for all interfaces)
API_HOST=0.0.0.0

# Port to listen on
API_PORT=8000

# Number of worker processes
API_WORKERS=4

# Enable auto-reload (development only)
API_RELOAD=true

# Rate limit: requests per minute (e.g., 100/minute, 1000/minute)
API_RATE_LIMIT=100/minute

# Maximum request size in bytes (100MB default)
API_MAX_REQUEST_SIZE=104857600

# Request timeout in seconds
API_REQUEST_TIMEOUT=30

# Enable CORS (true/false)
API_CORS_ENABLED=true

# CORS allowed origins (comma-separated or * for all)
API_CORS_ORIGINS=*

# Enable CORS credentials
API_CORS_CREDENTIALS=true

# ============================================================================
# AUTHENTICATION CONFIGURATION
# ============================================================================
# Enable authentication (true/false)
AUTH_ENABLED=false

# JWT secret key (generate with: openssl rand -hex 32)
AUTH_JWT_SECRET_KEY=your_jwt_secret_key_here

# JWT algorithm (HS256, RS256, etc.)
AUTH_JWT_ALGORITHM=HS256

# JWT expiration hours
AUTH_JWT_EXPIRATION_HOURS=24

# API keys for programmatic access (comma-separated)
# Format: key1,key2,key3
AUTH_API_KEYS=your_api_key_1,your_api_key_2

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================
# Database URL
#   SQLite: sqlite:///./docqa.db
#   PostgreSQL: postgresql://user:password@localhost:5432/docqa
#   MySQL: mysql://user:password@localhost:3306/docqa
DATABASE_URL=sqlite:///./docqa.db

# Database pool size (for PostgreSQL/MySQL)
DATABASE_POOL_SIZE=10

# Database max overflow connections
DATABASE_MAX_OVERFLOW=20

# Echo SQL queries (true/false)
DATABASE_ECHO=false

# ============================================================================
# CACHE CONFIGURATION
# ============================================================================
# Enable caching (true/false)
CACHE_ENABLED=true

# Redis URL (for production)
REDIS_URL=redis://localhost:6379/0

# Redis password (if required)
REDIS_PASSWORD=

# Cache TTL in seconds
CACHE_TTL_SECONDS=3600

# Maximum cache size (number of items)
CACHE_MAX_SIZE=1000

# ============================================================================
# DOCUMENT PROCESSING CONFIGURATION
# ============================================================================
# Maximum file size in MB
PROCESSING_MAX_FILE_SIZE_MB=100

# Supported file extensions (comma-separated)
PROCESSING_SUPPORTED_EXTENSIONS=.pdf,.docx,.txt,.md,.html,.csv,.json

# Chunk size in characters
PROCESSING_CHUNK_SIZE=1000

# Chunk overlap in characters
PROCESSING_CHUNK_OVERLAP=200

# Chunking strategy: fixed_size, sentence, paragraph, recursive, sliding_window, markdown
PROCESSING_CHUNKING_STRATEGY=recursive

# Language for NLP processing (en, es, fr, de, etc.)
PROCESSING_LANGUAGE=en

# Preserve formatting (true/false)
PROCESSING_PRESERVE_FORMATTING=true

# Extract tables from documents (true/false)
PROCESSING_EXTRACT_TABLES=true

# Extract images (true/false) - requires additional libraries
PROCESSING_EXTRACT_IMAGES=false

# ============================================================================
# MONITORING CONFIGURATION
# ============================================================================
# Enable monitoring (true/false)
MONITORING_ENABLED=true

# Metrics port for Prometheus
MONITORING_METRICS_PORT=9090

# Enable distributed tracing (true/false)
MONITORING_TRACING_ENABLED=false

# Jaeger agent host
MONITORING_JAEGER_HOST=localhost

# Jaeger agent port
MONITORING_JAEGER_PORT=6831

# Log requests (true/false)
MONITORING_LOG_REQUESTS=true

# Log responses (true/false)
MONITORING_LOG_RESPONSES=false

# ============================================================================
# AWS CONFIGURATION (for cloud deployments)
# ============================================================================
# AWS Access Key ID
AWS_ACCESS_KEY_ID=

# AWS Secret Access Key
AWS_SECRET_ACCESS_KEY=

# AWS Region
AWS_REGION=us-east-1

# S3 Bucket for document storage
AWS_S3_BUCKET=docqa-documents

# S3 Bucket for embeddings
AWS_S3_EMBEDDINGS_BUCKET=docqa-embeddings

# ============================================================================
# GCP CONFIGURATION
# ============================================================================
# GCP Project ID
GCP_PROJECT_ID=

# GCP Service Account JSON file path
GCP_SERVICE_ACCOUNT_FILE=

# GCS Bucket for document storage
GCP_GCS_BUCKET=docqa-documents

# ============================================================================
# AZURE CONFIGURATION
# ============================================================================
# Azure Storage Account
AZURE_STORAGE_ACCOUNT=

# Azure Storage Key
AZURE_STORAGE_KEY=

# Azure Container for document storage
AZURE_CONTAINER=docqa-documents

# ============================================================================
# SECURITY & RATE LIMITING
# ============================================================================
# Allowed hosts (comma-separated, * for all)
ALLOWED_HOSTS=*

# Trusted proxies (comma-separated IPs)
TRUSTED_PROXIES=

# Rate limit per IP (requests/minute)
RATE_LIMIT_PER_IP=100

# Rate limit for authenticated users (requests/minute)
RATE_LIMIT_AUTHENTICATED=1000

# Enable IP blocking (true/false)
IP_BLOCKING_ENABLED=false

# Blocked IPs (comma-separated)
BLOCKED_IPS=

# ============================================================================
# FEATURE FLAGS
# ============================================================================
# Enable WebSocket support
FEATURE_WEBSOCKET_ENABLED=true

# Enable file upload
FEATURE_FILE_UPLOAD_ENABLED=true

# Enable document deletion
FEATURE_DOCUMENT_DELETE_ENABLED=true

# Enable document listing
FEATURE_DOCUMENT_LIST_ENABLED=true

# Enable metrics endpoint
FEATURE_METRICS_ENABLED=true

# Enable batch querying
FEATURE_BATCH_QUERY_ENABLED=false

# ============================================================================
# MISC CONFIGURATION
# ============================================================================
# Default timezone
TIMEZONE=UTC

# Date format for logging
DATE_FORMAT=%Y-%m-%d %H:%M:%S

# Enable telemetry (anonymous usage data)
TELEMETRY_ENABLED=false

# GitHub repository URL (for feedback links)
GITHUB_REPO_URL=https://github.com/yourusername/doc-qa-ai

# Support email
SUPPORT_EMAIL=support@docqa-ai.com
